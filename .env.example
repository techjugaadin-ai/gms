NEXT_PUBLIC_APP_NAME=GMS

# Required: generate with `openssl rand -base64 32`
AUTH_SECRET=change-me-in-production

# Storage mode: json (local) | blob (Vercel production)
# - json: Uses .sessions directory (local development only)
# - blob: Uses Vercel Blob storage (production on Vercel)
# Note: When connected to Vercel, Blob SDK auto-authenticates - no token needed in env
STORAGE_MODE=json

# Demo credentials
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_GYM_OWNER_PASSWORD=Owner@123

# Demo emails
DEMO_ADMIN_EMAIL=superadmin@gms.local
DEMO_GYM_OWNER_EMAIL=owner@gms.local
